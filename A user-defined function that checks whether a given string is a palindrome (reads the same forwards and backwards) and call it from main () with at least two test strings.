#include <stdio.h>

int isPalindrome(char str[]) {
    int len = 0;
    while (str[len] != '\0') {
        len++;
    }
    
    for (int i = 0; i < len / 2; i++) {
        if (str[i] != str[len - 1 - i]) {
            return 0;
        }
    }
    return 1;
}

int main() {
    char str1[50], str2[50];
    scanf("%s", str1);
    scanf("%s", str2);
    
    if (isPalindrome(str1)) printf("%s is a Palindrome\n", str1);
    else printf("%s is not a Palindrome\n", str1);
    
    if (isPalindrome(str2)) printf("%s is a Palindrome\n", str2);
    else printf("%s is not a Palindrome\n", str2);
    
    return 0;
}
