#include <stdio.h>

int main() {
    double a, b;
    char choice;
    
    scanf("%lf %lf", &a, &b);
    scanf(" %c", &choice);
    
    switch (choice) {
        case '+':
            printf("Result = %.0f\n", a + b);
            break;
        case '-':
            printf("Result = %.0f\n", a - b);
            break;
        case '*':
            printf("Result = %.0f\n", a * b);
            break;
        case '/':
            if (b != 0) printf("Result = %.2f\n", a / b);
            else printf("Error: Division by zero\n");
            break;
        default:
            printf("Invalid choice\n");
    }
    
    return 0;
}
